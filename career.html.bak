        <title>Asha Grill House | Career</title>

        <!-- Styles and fonts -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
        <link rel="icon" href="./images/favicon.ico">

    <link rel="stylesheet" href="./style/career.css">
</head>
<body>

<div class="container">

    <h1 class="page-title">Application Form</h1>

    <!-- Language Buttons -->
    <div class="lang-buttons">
        <button onclick="showLang('en')">English</button>
        <button onclick="showLang('bn')">বাংলা</button>
        <button onclick="showLang('hi')">हिंदी</button>
    </div>

    <div class="content">

        <!-- LEFT TEXT SECTION -->
        <div class="info-box">

            <!-- ENGLISH -->
            <div class="lang en">
                <h2>Work With Asha Grill House</h2>
                <p>
                    At Asha Grill House, we believe that quality food comes from quality people.
                    We expect our employees to be humble, honest, hardworking, polite, and punctual.
                    Teamwork, cleanliness, and customer satisfaction matter most to us.
                </p>
                <p>
                    📞 Contact: <strong>+91 99932134803</strong>
                </p>
            </div>

            <!-- BENGALI -->
            <div class="lang bn">
                <h2>আশা গ্রিল হাউসে কাজ করুন</h2>
                <p>
                    আশা গ্রিল হাউসে আমরা বিশ্বাস করি ভালো খাবার আসে ভালো মানুষের হাত ধরে।
                    আমাদের কর্মীরা সৎ, ভদ্র, পরিশ্রমী এবং সময়নিষ্ঠ হওয়া আবশ্যক।
                    পরিষ্কার-পরিচ্ছন্নতা ও গ্রাহক সন্তুষ্টি আমাদের প্রধান লক্ষ্য।
                </p>
                <p>
                    📞 যোগাযোগ: <strong>+91 9932134803</strong>
                </p>
            </div>

            <!-- HINDI -->
            <div class="lang hi">
                <h2>आशा ग्रिल हाउस में काम करें</h2>
                <p>
                    आशा ग्रिल हाउस में हम मानते हैं कि अच्छा खाना अच्छे लोगों से आता है।
                    हमारे कर्मचारी ईमानदार, मेहनती, विनम्र और समय के पाबंद होने चाहिए।
                    स्वच्छता और ग्राहक संतुष्टि हमारे लिए सबसे महत्वपूर्ण है।
                </p>
                <p>
                    📞 संपर्क: <strong>+91 9932134803</strong>
                </p>
            </div>

        </div>

        <!-- RIGHT FORM SECTION -->
        <div class="form-box">
            <form action="submit.php" method="POST" enctype="multipart/form-data">

                <input type="text" name="name" placeholder="Full Name" required>
                <input type="number" name="phone" placeholder="10 digit phone number" required>
                <input type="text" name="father_name" placeholder="Father's Name" required>
                <textarea name="address" placeholder="Address" required></textarea>

                <select name="gender" required>
                    <option value="">Select Gender</option>
                    <option>Male</option>
                    <option>Female</option>
                    <option>Other</option>
                </select>

                <input type="number" name="age" placeholder="Age (18+ only)" min="18" required>

                <select name="planet" required>
                    <option value="" disabled selected>Choose your planet</option>
                    <option value="mercury">Mercury</option>
                    <option value="venus">Venus</option>
                    <option value="earth">Earth</option>
                    <option value="mars">Mars</option>
                    <option value="jupiter">Jupiter</option>
                    <option value="saturn">Saturn</option>
                    <option value="uranus">Uranus</option>
                    <option value="neptune">Neptune</option>
                    <option value="pluto">Pluto</option>
                </select>

                <select id="legs" name="legs" required>
                    <option value="" disabled selected>Select leg count</option>
                    <option value="2">2</option>
                    <option value="4">4</option>
                    <option value="6">6</option>
                    <option value="more">More than 6</option>
                </select>

                <select id="species" name="species" required>
                    <option value="" disabled selected>Select species</option>
                    <option value="alien">Alien</option>
                    <option value="human">Human</option>
                    <option value="animal">Animal</option>
                    <option value="ghost">Ghost</option>
                    <option value="dracula">Dracula</option>
                    <option value="zombie">Zombie</option>
                </select>




                <input type="file" name="aadhaar" accept=".jpg,.jpeg,.png,.pdf" required>

                <button type="submit">Submit Application</button>
            </form>
        </div>

    </div>
</div>


